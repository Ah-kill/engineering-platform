{
  "name": "engineering-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "create-admin": "npm run create-admin --workspace apps/api --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "update:claude": "npm install @anthropic-ai/claude-agent-sdk@latest --workspace apps/api && npm run runtime:build && npm test --workspace apps/api",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report",
    "runtime:build": "node -e \"const v=require('./node_modules/@anthropic-ai/claude-agent-sdk/package.json').claudeCodeVersion;require('child_process').execFileSync('docker',['build','--build-arg','CLAUDE_CODE_VERSION='+v,'-t','engineering-platform-workspace:'+v,'apps/runtime'],{stdio:'inherit'})\""
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
