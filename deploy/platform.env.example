# /etc/engineering-platform/platform.env  (owner root, group eplatform, mode 0640)
# Read by deploy/engineering-platform.service. See docs/03-deployment.md.

# The exact URL people open in the browser. Every change is refused from any other origin.
#   Tailscale:  https://platform-host.your-tailnet.ts.net
#   Caddy:      https://platform.example.com
WEB_ORIGIN=https://platform-host.your-tailnet.ts.net
COOKIE_SECURE=true

# Postgres on this machine, bound to localhost, with a long random password.
DATABASE_URL=postgres://platform:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/engineering_platform

# Encrypts saved Anthropic keys, subscription tokens and GitHub tokens.
# Generate once:  openssl rand -base64 32
# Keep a copy in your password manager. Lose it and every saved credential is unreadable.
VAULT_KEY=CHANGE_ME_BASE64_32_BYTES

# Optional
# SESSION_TTL_HOURS=12
# AGENT_MAX_BUDGET_USD=10
# WORKSPACE_CPUS=2
# WORKSPACE_MEMORY=4g
# LOG_LEVEL=info

# Number of reverse proxies in front of the API (Caddy or tailscale serve = 1)
TRUST_PROXY_HOPS=1
